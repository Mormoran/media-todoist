rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in Google account owns everything under users/{its uid}.
    // Nobody else can read or write it, signed-out visitors see nothing.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
